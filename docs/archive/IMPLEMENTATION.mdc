### ICS Generation

```javascript
function generateICS({ months, currentCost, bestCost, savings, url }) {
  const date = new Date();
  date.setMonth(date.getMonth() + months);
  
  const event = {
    title: 'Verificar tarifa de eletricidade',
    date: formatICSDate(date),
    description: [
      `Última vez pagavas €${currentCost}/mês.`,
      `Podias poupar €${savings}/ano.`,
      `Verifica se há ofertas melhores.`,
      '',
      url
    ].join('\\n'),
    url
  };
  
  return createICSBlob(event);
}
```

